GEMINI_API_KEY=adicione_sua_chave_gemini
# Opcional: ativa a continuação pelo OpenRouter quando o Gemini falhar por limite temporário.
OPENROUTER_API_KEY=adicione_sua_chave_openrouter
# Opcional; openrouter/free escolhe um modelo gratuito disponível.
OPENROUTER_MODEL=openrouter/free
# Opcional; modelos reserva dos modos Lite e High.
OPENROUTER_MODEL_LITE=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_HIGH=nvidia/nemotron-3-ultra-550b-a55b:free
SECRET_KEY=gere_uma_chave_aleatoria_longa
# Opcional no desenvolvimento local; o padrão é chat.db nesta pasta.
# Para produção, informe a URL do PostgreSQL como DATABASE_URL.
